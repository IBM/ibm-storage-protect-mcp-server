# Include documentation
include README.md
include LICENSE
include requirements-mcp-server.txt

# Include documentation directory
recursive-include docs *.md

# Include scripts
recursive-include scripts *.py *.sh *.ps1

# Include test documentation
recursive-include tests/docs *.md

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib

# Exclude PDF files (too large for distribution)
exclude pdf/*
prune pdf